pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building Website...'

                sh '''
                mkdir -p build
                cp -r * build/
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Testing Website...'

                sh '''
                test -f index.html
                '''
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'build/**', fingerprint: true
            }
        }
    }
}