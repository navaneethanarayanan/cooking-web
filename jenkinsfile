pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Building Website...'

                sh '''
                    rm -rf build
                    mkdir -p build
                    cp hello.html helo.js style.css build/
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Testing Website...'

                sh '''
                    test -f hello.html
                '''
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'build/**', fingerprint: true
            }
        }
    }
}
